<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>MiTienda POS</title>

<!-- ═══════════════════════════════════════════════
     META TAGS PWA — iOS Safari y Android Chrome
═══════════════════════════════════════════════ -->
<meta name="description" content="Punto de venta offline para tu negocio">
<meta name="theme-color" content="#1a1a2e">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="MiTienda">

<!-- Iconos para iOS (generados vía canvas en el script) -->
<link rel="apple-touch-icon" id="apple-icon-link">
<link rel="manifest" id="manifest-link">

<style>
/* ═══════════════════════════════════════════════
   VARIABLES Y RESET
═══════════════════════════════════════════════ */
:root {
  --bg:         #0f0f1a;
  --bg2:        #1a1a2e;
  --bg3:        #16213e;
  --card:       #1e1e35;
  --card2:      #252540;
  --accent:     #e94560;
  --accent2:    #f5a623;
  --green:      #2ecc71;
  --green-dim:  #1a7a44;
  --text:       #f0f0f5;
  --text2:      #9999bb;
  --text3:      #5555aa;
  --border:     rgba(255,255,255,0.07);
  --shadow:     0 8px 32px rgba(0,0,0,0.5);
  --radius:     16px;
  --radius-sm:  10px;
  --font-body:  'DM Sans', system-ui, sans-serif;
  --font-num:   'DM Mono', 'Courier New', monospace;
  --nav-h:      68px;
  --safe-bot:   env(safe-area-inset-bottom, 0px);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { height: 100%; -webkit-tap-highlight-color: transparent; }

body {
  font-family: var(--font-body);
  background: var(--bg);
  color: var(--text);
  height: 100%;
  overflow: hidden;
  position: fixed;
  width: 100%;
}

/* Importar fuentes online (se cachean con SW) */
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap');

/* ═══════════════════════════════════════════════
   LAYOUT PRINCIPAL
═══════════════════════════════════════════════ */
#app {
  display: flex;
  flex-direction: column;
  height: 100%;
  height: 100dvh;
}

/* Pantallas */
.screen {
  display: none;
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
  -webkit-overflow-scrolling: touch;
  padding-bottom: calc(var(--nav-h) + var(--safe-bot) + 16px);
}
.screen.active { display: block; }

/* ═══════════════════════════════════════════════
   BARRA DE NAVEGACIÓN INFERIOR
═══════════════════════════════════════════════ */
#bottom-nav {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  height: calc(var(--nav-h) + var(--safe-bot));
  padding-bottom: var(--safe-bot);
  background: var(--bg2);
  border-top: 1px solid var(--border);
  display: flex;
  z-index: 100;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.nav-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  background: none;
  border: none;
  color: var(--text3);
  font-family: var(--font-body);
  font-size: 11px;
  font-weight: 500;
  cursor: pointer;
  transition: color .2s, transform .1s;
  padding: 8px 4px;
  min-height: 48px;
  position: relative;
}
.nav-btn .nav-icon {
  font-size: 22px;
  line-height: 1;
  transition: transform .2s;
}
.nav-btn.active {
  color: var(--accent);
}
.nav-btn.active .nav-icon {
  transform: scale(1.15);
}
.nav-btn:active { transform: scale(0.93); }

/* Badge cesta */
#badge-cesta {
  position: absolute;
  top: 6px; right: calc(50% - 20px);
  background: var(--accent);
  color: #fff;
  font-size: 10px;
  font-weight: 700;
  font-family: var(--font-num);
  min-width: 18px;
  height: 18px;
  border-radius: 9px;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 0 4px;
}
#badge-cesta.visible { display: flex; }

/* ═══════════════════════════════════════════════
   CABECERAS DE SECCIÓN
═══════════════════════════════════════════════ */
.section-header {
  padding: 20px 16px 12px;
  position: sticky;
  top: 0;
  background: var(--bg);
  z-index: 10;
  border-bottom: 1px solid var(--border);
}
.section-header h1 {
  font-size: 22px;
  font-weight: 700;
  letter-spacing: -0.5px;
}
.section-header h1 span {
  color: var(--accent);
}
.section-subtitle {
  font-size: 13px;
  color: var(--text2);
  margin-top: 2px;
}

/* ═══════════════════════════════════════════════
   PANTALLA: VENDER — CUADRÍCULA
═══════════════════════════════════════════════ */
#grid-productos {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
  padding: 16px;
}
@media (min-width: 480px) { #grid-productos { grid-template-columns: repeat(3, 1fr); } }
@media (min-width: 768px) { #grid-productos { grid-template-columns: repeat(4, 1fr); } }

.producto-card {
  background: var(--card);
  border-radius: var(--radius);
  overflow: hidden;
  cursor: pointer;
  transition: transform .15s, box-shadow .15s;
  border: 1px solid var(--border);
  position: relative;
  user-select: none;
  -webkit-user-select: none;
}
.producto-card:active { transform: scale(0.94); }
.producto-card.agotado { opacity: 0.45; pointer-events: none; }
.producto-card.agotado::after {
  content: 'AGOTADO';
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0,0,0,0.55);
  color: var(--accent);
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 1px;
  border-radius: var(--radius);
}

.producto-card:not(.agotado):hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 30px rgba(233,69,96,0.15);
  border-color: rgba(233,69,96,0.3);
}

.card-img-wrap {
  width: 100%;
  aspect-ratio: 1;
  overflow: hidden;
  background: var(--bg3);
  position: relative;
}
.card-img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.card-img-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40px;
}

/* Animación de añadir a cesta */
@keyframes addPop {
  0%   { transform: scale(1); }
  40%  { transform: scale(0.91); }
  70%  { transform: scale(1.06); }
  100% { transform: scale(1); }
}
.producto-card.pop { animation: addPop .3s ease; }

.card-info {
  padding: 10px 10px 12px;
}
.card-nombre {
  font-size: 13px;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 3px;
}
.card-precio {
  font-family: var(--font-num);
  font-size: 14px;
  font-weight: 500;
  color: var(--accent2);
}
.card-stock {
  font-size: 11px;
  color: var(--text3);
  margin-top: 2px;
}

/* Mensaje sin productos */
#sin-productos {
  display: none;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60px 24px;
  gap: 12px;
  text-align: center;
}
#sin-productos .big-emoji { font-size: 64px; }
#sin-productos p { color: var(--text2); font-size: 15px; }

/* ═══════════════════════════════════════════════
   PANEL DE CESTA (BOTTOM SHEET)
═══════════════════════════════════════════════ */
#cesta-sheet {
  position: fixed;
  left: 0; right: 0; bottom: calc(var(--nav-h) + var(--safe-bot));
  background: var(--bg2);
  border-radius: 20px 20px 0 0;
  border-top: 1px solid var(--border);
  z-index: 50;
  transform: translateY(100%);
  transition: transform .35s cubic-bezier(.32,.72,0,1);
  max-height: 85dvh;
  display: flex;
  flex-direction: column;
}
#cesta-sheet.open { transform: translateY(0); }

.sheet-handle {
  width: 36px; height: 4px;
  background: var(--text3);
  border-radius: 2px;
  margin: 12px auto 8px;
  flex-shrink: 0;
  cursor: pointer;
}
.sheet-title {
  padding: 0 16px 12px;
  font-size: 17px;
  font-weight: 700;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--border);
}
.btn-vaciar {
  font-size: 13px;
  color: var(--accent);
  background: none;
  border: none;
  cursor: pointer;
  font-family: var(--font-body);
  padding: 6px 10px;
  border-radius: 8px;
  transition: background .2s;
}
.btn-vaciar:hover { background: rgba(233,69,96,0.12); }

#cesta-lista {
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  flex: 1;
  padding: 8px 0;
}

.cesta-item {
  display: grid;
  grid-template-columns: 44px 1fr auto auto auto;
  align-items: center;
  gap: 8px;
  padding: 10px 16px;
  border-bottom: 1px solid var(--border);
  animation: slideIn .2s ease;
}
@keyframes slideIn {
  from { opacity: 0; transform: translateX(-10px); }
  to   { opacity: 1; transform: translateX(0); }
}

.cesta-thumb {
  width: 44px; height: 44px;
  border-radius: var(--radius-sm);
  object-fit: cover;
  background: var(--bg3);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  overflow: hidden;
}
.cesta-thumb img { width: 100%; height: 100%; object-fit: cover; }

.cesta-nombre {
  font-size: 13px;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cesta-precio {
  font-size: 11px;
  color: var(--text2);
  font-family: var(--font-num);
}

.qty-ctrl {
  display: flex;
  align-items: center;
  gap: 0;
  background: var(--card2);
  border-radius: 10px;
  overflow: hidden;
}
.qty-btn {
  width: 32px; height: 32px;
  background: none;
  border: none;
  color: var(--text);
  font-size: 18px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background .15s;
  flex-shrink: 0;
}
.qty-btn:active { background: rgba(255,255,255,0.1); }
.qty-num {
  font-family: var(--font-num);
  font-size: 14px;
  font-weight: 500;
  min-width: 28px;
  text-align: center;
}

.cesta-subtotal {
  font-family: var(--font-num);
  font-size: 13px;
  font-weight: 600;
  color: var(--accent2);
  min-width: 52px;
  text-align: right;
}

.btn-quitar {
  background: none;
  border: none;
  color: var(--text3);
  font-size: 18px;
  cursor: pointer;
  padding: 6px;
  border-radius: 8px;
  transition: color .2s, background .2s;
  display: flex;
  align-items: center;
}
.btn-quitar:active { color: var(--accent); background: rgba(233,69,96,0.1); }

/* Panel de pago */
#panel-pago {
  padding: 12px 16px;
  border-top: 1px solid var(--border);
  flex-shrink: 0;
  background: var(--bg2);
  padding-bottom: 16px;
}

.total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}
.total-label {
  font-size: 15px;
  font-weight: 600;
  color: var(--text2);
}
.total-valor {
  font-family: var(--font-num);
  font-size: 24px;
  font-weight: 700;
  color: var(--text);
}

.pago-row {
  display: flex;
  gap: 8px;
  margin-bottom: 10px;
}
.input-dinero {
  flex: 1;
  background: var(--card2);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  color: var(--text);
  font-family: var(--font-num);
  font-size: 16px;
  padding: 12px 14px;
  outline: none;
  transition: border-color .2s;
  min-height: 48px;
}
.input-dinero:focus { border-color: var(--accent); }
.input-dinero::placeholder { color: var(--text3); }

.btn-calcular {
  background: var(--card2);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  color: var(--text2);
  font-family: var(--font-body);
  font-size: 13px;
  font-weight: 600;
  padding: 0 14px;
  cursor: pointer;
  min-height: 48px;
  transition: background .2s, color .2s;
  white-space: nowrap;
}
.btn-calcular:active { background: var(--card); }

#cambio-display {
  display: none;
  align-items: center;
  gap: 8px;
  padding: 10px 14px;
  border-radius: var(--radius-sm);
  margin-bottom: 10px;
  font-size: 15px;
  font-weight: 600;
  font-family: var(--font-num);
}
#cambio-display.ok {
  display: flex;
  background: rgba(46,204,113,0.12);
  color: var(--green);
  border: 1px solid rgba(46,204,113,0.25);
}
#cambio-display.err {
  display: flex;
  background: rgba(233,69,96,0.12);
  color: var(--accent);
  border: 1px solid rgba(233,69,96,0.25);
}

.btn-cobrar {
  width: 100%;
  background: linear-gradient(135deg, var(--green), #27ae60);
  border: none;
  border-radius: var(--radius-sm);
  color: #fff;
  font-family: var(--font-body);
  font-size: 17px;
  font-weight: 700;
  padding: 15px;
  cursor: pointer;
  min-height: 54px;
  transition: opacity .2s, transform .1s;
  letter-spacing: 0.3px;
}
.btn-cobrar:active { opacity: 0.85; transform: scale(0.98); }
.btn-cobrar:disabled { background: var(--card2); color: var(--text3); cursor: default; }

/* FAB para abrir cesta */
#fab-cesta {
  position: fixed;
  bottom: calc(var(--nav-h) + var(--safe-bot) + 16px);
  right: 16px;
  background: var(--accent);
  color: #fff;
  border: none;
  border-radius: 20px;
  padding: 14px 20px;
  font-family: var(--font-body);
  font-size: 15px;
  font-weight: 700;
  cursor: pointer;
  display: none;
  align-items: center;
  gap: 8px;
  box-shadow: 0 6px 24px rgba(233,69,96,0.45);
  z-index: 45;
  transition: transform .2s, box-shadow .2s;
}
#fab-cesta.visible { display: flex; }
#fab-cesta:active { transform: scale(0.94); }
#fab-total-fab {
  font-family: var(--font-num);
  font-weight: 500;
  opacity: 0.9;
}

/* ═══════════════════════════════════════════════
   PANTALLA: INVENTARIO
═══════════════════════════════════════════════ */
/* Botón Añadir producto */
.btn-add-producto {
  display: flex;
  align-items: center;
  gap: 8px;
  background: var(--accent);
  color: #fff;
  border: none;
  border-radius: var(--radius-sm);
  font-family: var(--font-body);
  font-size: 14px;
  font-weight: 600;
  padding: 10px 16px;
  cursor: pointer;
  min-height: 44px;
  transition: opacity .2s;
}
.btn-add-producto:active { opacity: 0.8; }

/* Formulario añadir producto */
#form-producto {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 20px 16px;
  margin: 16px;
  display: none;
}
#form-producto.open { display: block; }
.form-titulo {
  font-size: 16px;
  font-weight: 700;
  margin-bottom: 16px;
  color: var(--text);
}

.field-group {
  margin-bottom: 14px;
}
.field-label {
  display: block;
  font-size: 12px;
  font-weight: 600;
  color: var(--text2);
  margin-bottom: 6px;
  letter-spacing: 0.5px;
  text-transform: uppercase;
}
.field-input {
  width: 100%;
  background: var(--bg3);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  color: var(--text);
  font-family: var(--font-body);
  font-size: 16px;
  padding: 12px 14px;
  outline: none;
  transition: border-color .2s;
  min-height: 48px;
  -webkit-appearance: none;
}
.field-input:focus { border-color: var(--accent); }
.field-input::placeholder { color: var(--text3); }

/* Input file personalizado */
.file-label {
  display: flex;
  align-items: center;
  gap: 10px;
  background: var(--bg3);
  border: 1px dashed var(--border);
  border-radius: var(--radius-sm);
  padding: 12px 14px;
  cursor: pointer;
  min-height: 48px;
  transition: border-color .2s, background .2s;
}
.file-label:hover { border-color: var(--accent); background: rgba(233,69,96,0.05); }
.file-label span { font-size: 14px; color: var(--text2); }
.file-label .file-icon { font-size: 20px; }
#input-imagen { display: none; }

#preview-imagen {
  display: none;
  width: 80px;
  height: 80px;
  object-fit: cover;
  border-radius: var(--radius-sm);
  margin-top: 10px;
  border: 2px solid var(--accent);
}

.form-acciones {
  display: flex;
  gap: 10px;
  margin-top: 18px;
}
.btn-guardar {
  flex: 1;
  background: var(--accent);
  color: #fff;
  border: none;
  border-radius: var(--radius-sm);
  font-family: var(--font-body);
  font-size: 15px;
  font-weight: 700;
  padding: 14px;
  cursor: pointer;
  min-height: 50px;
  transition: opacity .2s;
}
.btn-guardar:active { opacity: 0.85; }
.btn-cancelar {
  background: var(--card2);
  color: var(--text2);
  border: none;
  border-radius: var(--radius-sm);
  font-family: var(--font-body);
  font-size: 15px;
  padding: 14px 20px;
  cursor: pointer;
  min-height: 50px;
}

/* Tabla inventario */
#tabla-inventario-wrap {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  margin: 16px;
}
.tabla-inv {
  width: 100%;
  border-collapse: collapse;
  min-width: 520px;
}
.tabla-inv th {
  background: var(--card);
  color: var(--text2);
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.6px;
  padding: 10px 8px;
  text-align: left;
  border-bottom: 1px solid var(--border);
  white-space: nowrap;
}
.tabla-inv td {
  padding: 10px 8px;
  border-bottom: 1px solid var(--border);
  font-size: 13px;
  vertical-align: middle;
}
.tabla-inv tr.agotado-row td { background: rgba(233,69,96,0.07); color: #f08; }
.tabla-inv tr:last-child td { border-bottom: none; }

.thumb-inv {
  width: 40px; height: 40px;
  border-radius: 8px;
  object-fit: cover;
  background: var(--bg3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  overflow: hidden;
  flex-shrink: 0;
}
.thumb-inv img { width: 100%; height: 100%; object-fit: cover; }

.num-verde { color: var(--green); font-family: var(--font-num); font-weight: 600; }
.num-rojo  { color: var(--accent); font-family: var(--font-num); font-weight: 700; }
.num-gris  { color: var(--text2); font-family: var(--font-num); }
.num-amarillo { color: var(--accent2); font-family: var(--font-num); }

.btn-del-prod {
  background: none;
  border: none;
  cursor: pointer;
  color: var(--text3);
  font-size: 16px;
  padding: 6px;
  border-radius: 6px;
  transition: color .2s, background .2s;
}
.btn-del-prod:active { color: var(--accent); background: rgba(233,69,96,0.1); }

/* Zona peligrosa */
.zona-peligrosa {
  margin: 24px 16px 8px;
  padding: 16px;
  background: rgba(233,69,96,0.07);
  border: 1px solid rgba(233,69,96,0.2);
  border-radius: var(--radius);
}
.zona-peligrosa h3 {
  font-size: 13px;
  color: var(--accent);
  margin-bottom: 10px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.btn-reiniciar {
  background: none;
  border: 1px solid var(--accent);
  color: var(--accent);
  border-radius: var(--radius-sm);
  font-family: var(--font-body);
  font-size: 14px;
  font-weight: 600;
  padding: 11px 18px;
  cursor: pointer;
  min-height: 44px;
  transition: background .2s;
}
.btn-reiniciar:active { background: rgba(233,69,96,0.15); }

/* ═══════════════════════════════════════════════
   MODAL / OVERLAY
═══════════════════════════════════════════════ */
#overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.6);
  z-index: 200;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 24px;
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
}
#overlay.open { display: flex; }

.modal {
  background: var(--bg2);
  border: 1px solid var(--border);
  border-radius: 20px;
  padding: 28px 24px;
  width: 100%;
  max-width: 360px;
  box-shadow: var(--shadow);
  animation: modalIn .25s cubic-bezier(.32,.72,0,1);
}
@keyframes modalIn {
  from { opacity: 0; transform: scale(0.9) translateY(20px); }
  to   { opacity: 1; transform: scale(1) translateY(0); }
}

.modal-icon { font-size: 48px; text-align: center; margin-bottom: 12px; }
.modal-title { font-size: 19px; font-weight: 700; text-align: center; margin-bottom: 8px; }
.modal-msg   { font-size: 14px; color: var(--text2); text-align: center; line-height: 1.5; margin-bottom: 24px; }
.modal-cambio {
  font-family: var(--font-num);
  font-size: 28px;
  font-weight: 700;
  color: var(--green);
  text-align: center;
  margin: 8px 0 24px;
}
.modal-acciones { display: flex; gap: 10px; }
.btn-modal-ok {
  flex: 1;
  background: var(--accent);
  color: #fff;
  border: none;
  border-radius: var(--radius-sm);
  font-family: var(--font-body);
  font-size: 16px;
  font-weight: 700;
  padding: 14px;
  cursor: pointer;
  min-height: 50px;
}
.btn-modal-cancel {
  flex: 1;
  background: var(--card2);
  color: var(--text2);
  border: none;
  border-radius: var(--radius-sm);
  font-family: var(--font-body);
  font-size: 16px;
  padding: 14px;
  cursor: pointer;
  min-height: 50px;
}

/* ═══════════════════════════════════════════════
   TOAST
═══════════════════════════════════════════════ */
#toast {
  position: fixed;
  top: 20px; left: 50%; transform: translateX(-50%) translateY(-80px);
  background: var(--card);
  color: var(--text);
  border: 1px solid var(--border);
  border-radius: 40px;
  padding: 12px 22px;
  font-size: 14px;
  font-weight: 500;
  z-index: 300;
  transition: transform .3s cubic-bezier(.32,.72,0,1);
  white-space: nowrap;
  box-shadow: var(--shadow);
  pointer-events: none;
}
#toast.visible { transform: translateX(-50%) translateY(0); }

/* ═══════════════════════════════════════════════
   BANNER DE INSTALACIÓN
═══════════════════════════════════════════════ */
#install-banner {
  position: fixed;
  top: 0; left: 0; right: 0;
  background: linear-gradient(135deg, var(--accent), #c0392b);
  color: #fff;
  padding: 14px 16px;
  display: none;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  z-index: 400;
  box-shadow: 0 4px 20px rgba(233,69,96,0.4);
}
#install-banner.visible { display: flex; }
.install-text { font-size: 14px; font-weight: 600; flex: 1; }
.btn-install {
  background: rgba(255,255,255,0.2);
  border: 1px solid rgba(255,255,255,0.4);
  color: #fff;
  border-radius: 8px;
  font-family: var(--font-body);
  font-size: 13px;
  font-weight: 700;
  padding: 8px 14px;
  cursor: pointer;
  white-space: nowrap;
  min-height: 36px;
}
.btn-install-close {
  background: none;
  border: none;
  color: rgba(255,255,255,0.7);
  font-size: 20px;
  cursor: pointer;
  padding: 4px;
  line-height: 1;
}

/* Scrollbar invisible */
::-webkit-scrollbar { display: none; }
* { scrollbar-width: none; }
</style>
</head>
<body>

<!-- ═══════════════════════════════════════════════
     BANNER DE INSTALACIÓN (Android/Chrome)
═══════════════════════════════════════════════ -->
<div id="install-banner">
  <span class="install-text">📱 Instala MiTienda en tu pantalla de inicio</span>
  <button class="btn-install" id="btn-instalar">Instalar</button>
  <button class="btn-install-close" id="btn-cerrar-banner">✕</button>
</div>

<!-- ═══════════════════════════════════════════════
     APP PRINCIPAL
═══════════════════════════════════════════════ -->
<div id="app">

  <!-- ─── PANTALLA VENDER ─── -->
  <div class="screen active" id="screen-vender">
    <div class="section-header">
      <h1>Punto de <span>Venta</span></h1>
      <p class="section-subtitle">Toca un producto para añadirlo a la cesta</p>
    </div>

    <div id="sin-productos">
      <div class="big-emoji">🏪</div>
      <p>No hay productos todavía.<br>Ve a <strong>Inventario</strong> para añadir el primero.</p>
    </div>

    <div id="grid-productos"></div>
  </div>

  <!-- ─── PANTALLA INVENTARIO ─── -->
  <div class="screen" id="screen-inventario">
    <div class="section-header" style="display:flex;align-items:center;justify-content:space-between;gap:12px;">
      <div>
        <h1><span>Inven</span>tario</h1>
        <p class="section-subtitle" id="subtitulo-inv">0 productos</p>
      </div>
      <button class="btn-add-producto" id="btn-toggle-form">
        <span>＋</span> Añadir
      </button>
    </div>

    <!-- Formulario añadir producto -->
    <div id="form-producto">
      <p class="form-titulo">Nuevo producto</p>

      <div class="field-group">
        <label class="field-label" for="inp-nombre">Nombre</label>
        <input class="field-input" id="inp-nombre" type="text"
               placeholder="Ej: Camiseta azul" autocomplete="off" autocorrect="off">
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
        <div class="field-group">
          <label class="field-label" for="inp-precio">Precio (€)</label>
          <input class="field-input" id="inp-precio" type="number"
                 min="0.01" step="0.01" placeholder="0.00" inputmode="decimal">
        </div>
        <div class="field-group">
          <label class="field-label" for="inp-stock">Stock inicial</label>
          <input class="field-input" id="inp-stock" type="number"
                 min="0" step="1" placeholder="0" inputmode="numeric">
        </div>
      </div>

      <div class="field-group">
        <label class="field-label">Imagen del producto</label>
        <label class="file-label" for="input-imagen">
          <span class="file-icon">📷</span>
          <span id="file-label-text">Seleccionar foto o usar cámara</span>
        </label>
        <input type="file" id="input-imagen" accept="image/*" capture="environment">
        <img id="preview-imagen" alt="Vista previa">
      </div>

      <div class="form-acciones">
        <button class="btn-guardar" id="btn-guardar-producto">Guardar producto</button>
        <button class="btn-cancelar" id="btn-cancelar-form">Cancelar</button>
      </div>
    </div>

    <!-- Tabla de inventario -->
    <div id="tabla-inventario-wrap">
      <table class="tabla-inv" id="tabla-inv">
        <thead>
          <tr>
            <th>Img</th>
            <th>Nombre</th>
            <th>Precio</th>
            <th>Inicial</th>
            <th>Vendidos</th>
            <th>Quedan</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="tbody-inv"></tbody>
      </table>
    </div>

    <!-- Zona peligrosa -->
    <div class="zona-peligrosa">
      <h3>⚠ Zona peligrosa</h3>
      <button class="btn-reiniciar" id="btn-reiniciar">Reiniciar todos los datos</button>
    </div>
  </div>

</div><!-- /#app -->

<!-- ─── CESTA (BOTTOM SHEET) ─── -->
<div id="cesta-sheet">
  <div class="sheet-handle" id="sheet-handle"></div>
  <div class="sheet-title">
    <span>🛒 Cesta</span>
    <button class="btn-vaciar" id="btn-vaciar">Vaciar</button>
  </div>
  <div id="cesta-lista"></div>
  <div id="panel-pago">
    <div class="total-row">
      <span class="total-label">Total a pagar</span>
      <span class="total-valor" id="total-display">0,00 €</span>
    </div>
    <div class="pago-row">
      <input class="input-dinero" id="inp-recibido"
             type="number" min="0" step="0.01" placeholder="Dinero recibido €"
             inputmode="decimal">
      <button class="btn-calcular" id="btn-calcular">Calcular</button>
    </div>
    <div id="cambio-display"></div>
    <button class="btn-cobrar" id="btn-cobrar">Cobrar venta ✓</button>
  </div>
</div>

<!-- FAB de cesta -->
<button id="fab-cesta" aria-label="Ver cesta">
  🛒 <span id="fab-total-fab"></span>
</button>

<!-- Barra de navegación inferior -->
<nav id="bottom-nav">
  <button class="nav-btn active" data-screen="vender" id="nav-vender">
    <span class="nav-icon">🏷️</span>
    <span>Vender</span>
    <span id="badge-cesta"></span>
  </button>
  <button class="nav-btn" data-screen="inventario" id="nav-inventario">
    <span class="nav-icon">📦</span>
    <span>Inventario</span>
  </button>
</nav>

<!-- Overlay / Modal -->
<div id="overlay">
  <div class="modal" id="modal">
    <div class="modal-icon" id="modal-icon"></div>
    <div class="modal-title" id="modal-title"></div>
    <div class="modal-msg" id="modal-msg"></div>
    <div class="modal-cambio" id="modal-cambio" style="display:none"></div>
    <div class="modal-acciones" id="modal-acciones"></div>
  </div>
</div>

<!-- Toast -->
<div id="toast"></div>


<script>
/* ═══════════════════════════════════════════════════════════════
   MITTIENDA POS — JavaScript principal
   Arquitectura: módulos con IIFE, datos en localStorage
═══════════════════════════════════════════════════════════════ */

'use strict';

/* ──────────────────────────────────────────────
   1. GENERACIÓN DE ICONOS (canvas → base64)
   Usados para el manifest y apple-touch-icon
────────────────────────────────────────────── */
function generarIcono(size) {
  const canvas = document.createElement('canvas');
  canvas.width = size; canvas.height = size;
  const ctx = canvas.getContext('2d');

  // Fondo degradado
  const grad = ctx.createLinearGradient(0, 0, size, size);
  grad.addColorStop(0,   '#1a1a2e');
  grad.addColorStop(0.5, '#16213e');
  grad.addColorStop(1,   '#e94560');
  ctx.fillStyle = grad;
  const r = size * 0.22;
  ctx.beginPath();
  ctx.moveTo(r, 0);
  ctx.lineTo(size - r, 0);
  ctx.quadraticCurveTo(size, 0, size, r);
  ctx.lineTo(size, size - r);
  ctx.quadraticCurveTo(size, size, size - r, size);
  ctx.lineTo(r, size);
  ctx.quadraticCurveTo(0, size, 0, size - r);
  ctx.lineTo(0, r);
  ctx.quadraticCurveTo(0, 0, r, 0);
  ctx.closePath();
  ctx.fill();

  // Emoji tienda
  ctx.font = `${size * 0.52}px serif`;
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.fillText('🏪', size / 2, size / 2 + size * 0.04);

  return canvas.toDataURL('image/png');
}

const icono192 = generarIcono(192);
const icono512 = generarIcono(512);

// Establecer apple-touch-icon
document.getElementById('apple-icon-link').href = icono192;

/* ──────────────────────────────────────────────
   2. MANIFEST INLINE (vía Blob URL)
────────────────────────────────────────────── */
const manifestData = {
  name: 'MiTienda POS',
  short_name: 'MiTienda',
  description: 'Punto de venta offline para pequeños negocios',
  start_url: './',
  display: 'standalone',
  background_color: '#0f0f1a',
  theme_color: '#1a1a2e',
  orientation: 'portrait-primary',
  icons: [
    { src: icono192, sizes: '192x192', type: 'image/png', purpose: 'any maskable' },
    { src: icono512, sizes: '512x512', type: 'image/png', purpose: 'any maskable' }
  ]
};
const manifestBlob = new Blob([JSON.stringify(manifestData)], { type: 'application/json' });
document.getElementById('manifest-link').href = URL.createObjectURL(manifestBlob);

/* ──────────────────────────────────────────────
   3. SERVICE WORKER INLINE (vía Blob)
   Cachea todo el HTML de la app para offline
────────────────────────────────────────────── */
const swCodigo = `
const CACHE = 'mittienda-v1';

// Al instalar: capturar la página actual
self.addEventListener('install', e => {
  e.waitUntil(
    caches.open(CACHE).then(cache =>
      cache.addAll([self.location.origin + self.location.pathname])
        .catch(() => {}) // Sin fallo si no hay red
    )
  );
  self.skipWaiting();
});

// Al activar: limpiar cachés viejos
self.addEventListener('activate', e => {
  e.waitUntil(
    caches.keys().then(keys =>
      Promise.all(keys.filter(k => k !== CACHE).map(k => caches.delete(k)))
    )
  );
  self.clients.claim();
});

// Interceptar peticiones — Cache-first para la app
self.addEventListener('fetch', e => {
  // Solo peticiones GET y mismo origen
  if (e.request.method !== 'GET') return;

  e.respondWith(
    caches.match(e.request).then(cached => {
      if (cached) return cached;

      return fetch(e.request).then(response => {
        if (response && response.status === 200) {
          const copia = response.clone();
          caches.open(CACHE).then(cache => cache.put(e.request, copia));
        }
        return response;
      }).catch(() => {
        // Sin red y sin caché: devolver respuesta vacía
        return new Response('Offline', { status: 503 });
      });
    })
  );
});
`;

if ('serviceWorker' in navigator) {
  const swBlob = new Blob([swCodigo], { type: 'application/javascript' });
  const swUrl  = URL.createObjectURL(swBlob);

  navigator.serviceWorker.register(swUrl, { scope: './' })
    .then(reg => {
      console.log('SW registrado:', reg.scope);
      // Cachear la página actual
      if (reg.installing) {
        reg.installing.postMessage({ type: 'CACHE_URLS', urls: [location.href] });
      }
    })
    .catch(err => console.warn('SW no registrado (normal en localhost file://):', err));
}

/* ──────────────────────────────────────────────
   4. ALMACENAMIENTO — localStorage
────────────────────────────────────────────── */
const Store = {
  // Claves
  KEYS: { productos: 'mt_productos', ventas: 'mt_ventas' },

  // Carga todos los productos
  getProductos() {
    try { return JSON.parse(localStorage.getItem(this.KEYS.productos)) || []; }
    catch { return []; }
  },

  // Guarda array de productos
  setProductos(arr) {
    localStorage.setItem(this.KEYS.productos, JSON.stringify(arr));
  },

  // Carga todas las ventas
  getVentas() {
    try { return JSON.parse(localStorage.getItem(this.KEYS.ventas)) || []; }
    catch { return []; }
  },

  // Guarda una venta nueva
  addVenta(venta) {
    const ventas = this.getVentas();
    ventas.push(venta);
    localStorage.setItem(this.KEYS.ventas, JSON.stringify(ventas));
  },

  // Borra todo
  reiniciar() {
    localStorage.removeItem(this.KEYS.productos);
    localStorage.removeItem(this.KEYS.ventas);
  }
};

/* ──────────────────────────────────────────────
   5. CESTA (estado en memoria)
────────────────────────────────────────────── */
let cesta = []; // [ { productoId, nombre, precio, imagen, cantidad } ]

function cestaTotal() {
  return cesta.reduce((s, i) => s + i.precio * i.cantidad, 0);
}

function cestaArticulos() {
  return cesta.reduce((s, i) => s + i.cantidad, 0);
}

/* ──────────────────────────────────────────────
   6. FORMATEO
────────────────────────────────────────────── */
function fmtEuro(n) {
  return n.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
}

/* ──────────────────────────────────────────────
   7. NAVEGACIÓN ENTRE PANTALLAS
────────────────────────────────────────────── */
function irA(screenId) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById('screen-' + screenId).classList.add('active');
  document.querySelectorAll('.nav-btn').forEach(b => {
    b.classList.toggle('active', b.dataset.screen === screenId);
  });

  if (screenId === 'inventario') renderTablaInventario();
  if (screenId === 'vender')     renderGrid();
}

document.querySelectorAll('.nav-btn').forEach(btn => {
  btn.addEventListener('click', () => irA(btn.dataset.screen));
});

/* ──────────────────────────────────────────────
   8. CUADRÍCULA DE PRODUCTOS (pantalla vender)
────────────────────────────────────────────── */
function renderGrid() {
  const productos = Store.getProductos();
  const grid    = document.getElementById('grid-productos');
  const sinProd = document.getElementById('sin-productos');

  grid.innerHTML = '';

  if (productos.length === 0) {
    sinProd.style.display = 'flex';
    return;
  }
  sinProd.style.display = 'none';

  productos.forEach(p => {
    const vendidos   = calcVendidos(p.id);
    const stockActual = p.stockInicial - vendidos;
    const agotado    = stockActual <= 0;

    const card = document.createElement('div');
    card.className = 'producto-card' + (agotado ? ' agotado' : '');
    card.dataset.id = p.id;

    card.innerHTML = `
      <div class="card-img-wrap">
        ${p.imagen
          ? `<img src="${p.imagen}" alt="${p.nombre}" loading="lazy">`
          : `<div class="card-img-placeholder">🛍️</div>`}
      </div>
      <div class="card-info">
        <div class="card-nombre">${esc(p.nombre)}</div>
        <div class="card-precio">${fmtEuro(p.precio)}</div>
        <div class="card-stock">Stock: ${stockActual}</div>
      </div>
    `;

    if (!agotado) {
      card.addEventListener('click', () => {
        añadirACesta(p);
        card.classList.remove('pop');
        void card.offsetWidth; // reflow para reiniciar animación
        card.classList.add('pop');
        // Actualizar stock visible
        card.querySelector('.card-stock').textContent =
          'Stock: ' + (p.stockInicial - calcVendidos(p.id) - (cestaItem(p.id)?.cantidad || 0));
      });
    }

    grid.appendChild(card);
  });
}

function esc(str) {
  return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

/* ──────────────────────────────────────────────
   9. GESTIÓN DE CESTA
────────────────────────────────────────────── */
function cestaItem(pid) {
  return cesta.find(i => i.productoId === pid);
}

function añadirACesta(p) {
  const item = cestaItem(p.id);
  if (item) {
    item.cantidad++;
  } else {
    cesta.push({ productoId: p.id, nombre: p.nombre, precio: p.precio, imagen: p.imagen, cantidad: 1 });
  }
  actualizarCesta();
}

function quitarDeCesta(pid) {
  cesta = cesta.filter(i => i.productoId !== pid);
  actualizarCesta();
}

function cambiarCantidad(pid, delta) {
  const item = cestaItem(pid);
  if (!item) return;
  item.cantidad += delta;
  if (item.cantidad <= 0) quitarDeCesta(pid);
  else actualizarCesta();
}

function vaciarCesta() {
  cesta = [];
  actualizarCesta();
  renderGrid();
}

function actualizarCesta() {
  renderCestaLista();
  renderPanelPago();
  actualizarBadge();
  actualizarFAB();
  // Limpiar cambio al modificar cesta
  document.getElementById('cambio-display').className = 'cambio-display';
  document.getElementById('cambio-display').style.display = 'none';
  document.getElementById('inp-recibido').value = '';
}

function renderCestaLista() {
  const lista = document.getElementById('cesta-lista');
  lista.innerHTML = '';

  if (cesta.length === 0) {
    lista.innerHTML = `<div style="text-align:center;padding:32px;color:var(--text3);font-size:14px;">
      La cesta está vacía.<br>Toca los productos para añadirlos.
    </div>`;
    return;
  }

  cesta.forEach(item => {
    const div = document.createElement('div');
    div.className = 'cesta-item';
    div.innerHTML = `
      <div class="cesta-thumb">
        ${item.imagen ? `<img src="${item.imagen}" alt="">` : '🛍️'}
      </div>
      <div>
        <div class="cesta-nombre">${esc(item.nombre)}</div>
        <div class="cesta-precio">${fmtEuro(item.precio)}/ud</div>
      </div>
      <div class="qty-ctrl">
        <button class="qty-btn" data-pid="${item.productoId}" data-d="-1">−</button>
        <span class="qty-num">${item.cantidad}</span>
        <button class="qty-btn" data-pid="${item.productoId}" data-d="1">+</button>
      </div>
      <div class="cesta-subtotal">${fmtEuro(item.precio * item.cantidad)}</div>
      <button class="btn-quitar" data-pid="${item.productoId}" aria-label="Quitar">✕</button>
    `;
    lista.appendChild(div);
  });

  // Eventos botones qty y quitar
  lista.querySelectorAll('.qty-btn').forEach(btn => {
    btn.addEventListener('click', e => {
      e.stopPropagation();
      cambiarCantidad(btn.dataset.pid, parseInt(btn.dataset.d));
    });
  });
  lista.querySelectorAll('.btn-quitar').forEach(btn => {
    btn.addEventListener('click', e => {
      e.stopPropagation();
      quitarDeCesta(btn.dataset.pid);
    });
  });
}

function renderPanelPago() {
  document.getElementById('total-display').textContent = fmtEuro(cestaTotal());
  const cobrar = document.getElementById('btn-cobrar');
  cobrar.disabled = cesta.length === 0;
}

function actualizarBadge() {
  const badge = document.getElementById('badge-cesta');
  const n = cestaArticulos();
  badge.textContent = n > 99 ? '99+' : n;
  badge.classList.toggle('visible', n > 0);
}

function actualizarFAB() {
  const fab = document.getElementById('fab-cesta');
  const total = cestaTotal();
  const n     = cestaArticulos();

  if (n > 0 && document.getElementById('screen-vender').classList.contains('active')) {
    fab.classList.add('visible');
    document.getElementById('fab-total-fab').textContent = fmtEuro(total);
  } else {
    fab.classList.remove('visible');
  }
}

/* ──────────────────────────────────────────────
   10. BOTTOM SHEET (cesta)
────────────────────────────────────────────── */
const cestaSheet = document.getElementById('cesta-sheet');

function abrirCesta() {
  renderCestaLista();
  renderPanelPago();
  cestaSheet.classList.add('open');
}
function cerrarCesta() {
  cestaSheet.classList.remove('open');
}

document.getElementById('fab-cesta').addEventListener('click', abrirCesta);
document.getElementById('sheet-handle').addEventListener('click', () => {
  cestaSheet.classList.toggle('open');
  if (cestaSheet.classList.contains('open')) { renderCestaLista(); renderPanelPago(); }
});
document.getElementById('btn-vaciar').addEventListener('click', () => {
  if (cesta.length === 0) return;
  mostrarModal({
    icono: '🗑️',
    titulo: '¿Vaciar cesta?',
    mensaje: 'Se eliminarán todos los productos de la cesta.',
    btnOk: 'Vaciar',
    btnCancel: 'Cancelar',
    onOk: () => { vaciarCesta(); cerrarCesta(); }
  });
});

// Swipe down para cerrar
let touchStartY = 0;
cestaSheet.addEventListener('touchstart', e => { touchStartY = e.touches[0].clientY; }, { passive: true });
cestaSheet.addEventListener('touchend', e => {
  const dy = e.changedTouches[0].clientY - touchStartY;
  if (dy > 60) cerrarCesta();
}, { passive: true });

/* ──────────────────────────────────────────────
   11. CALCULAR CAMBIO
────────────────────────────────────────────── */
document.getElementById('btn-calcular').addEventListener('click', calcularCambio);
document.getElementById('inp-recibido').addEventListener('keydown', e => {
  if (e.key === 'Enter') calcularCambio();
});

function calcularCambio() {
  const display  = document.getElementById('cambio-display');
  const recibido = parseFloat(document.getElementById('inp-recibido').value);
  const total    = cestaTotal();

  if (isNaN(recibido) || recibido < 0) {
    display.textContent = '⚠ Introduce una cantidad válida';
    display.className   = 'err';
    display.style.display = 'flex';
    return;
  }
  if (recibido < total) {
    display.textContent = `⚠ Faltan ${fmtEuro(total - recibido)}`;
    display.className   = 'err';
    display.style.display = 'flex';
    return;
  }
  const cambio = recibido - total;
  display.innerHTML = `✓ Cambio a devolver: <strong style="margin-left:6px;font-size:17px;">${fmtEuro(cambio)}</strong>`;
  display.className   = 'ok';
  display.style.display = 'flex';
}

/* ──────────────────────────────────────────────
   12. COBRAR VENTA
────────────────────────────────────────────── */
document.getElementById('btn-cobrar').addEventListener('click', cobrarVenta);

function calcVendidos(pid) {
  const ventas = Store.getVentas();
  let total = 0;
  ventas.forEach(v => {
    v.items.forEach(i => {
      if (i.productoId === pid) total += i.cantidad;
    });
  });
  return total;
}

function cobrarVenta() {
  if (cesta.length === 0) return;

  const productos = Store.getProductos();

  // Verificar stock suficiente
  for (const item of cesta) {
    const p = productos.find(x => x.id === item.productoId);
    if (!p) continue;
    const vendidos    = calcVendidos(p.id);
    const stockActual = p.stockInicial - vendidos;
    if (item.cantidad > stockActual) {
      mostrarModal({
        icono: '⚠️',
        titulo: 'Stock insuficiente',
        mensaje: `No hay suficiente stock de "<strong>${esc(item.nombre)}</strong>".<br>
                  Disponibles: ${stockActual} — Solicitados: ${item.cantidad}`,
        btnOk: 'Entendido'
      });
      return;
    }
  }

  // Calcular cambio
  const recibido  = parseFloat(document.getElementById('inp-recibido').value) || 0;
  const total     = cestaTotal();
  const cambio    = recibido - total;

  // Guardar venta
  const venta = {
    id:    Date.now(),
    fecha: new Date().toISOString(),
    items: cesta.map(i => ({ productoId: i.productoId, nombre: i.nombre, cantidad: i.cantidad, precio: i.precio })),
    total
  };
  Store.addVenta(venta);

  const cajaMensaje = cambio > 0
    ? `Venta registrada.<br>Cambio a devolver: <strong style="color:var(--green)">${fmtEuro(cambio)}</strong>`
    : 'Venta registrada correctamente.';

  // Limpiar y actualizar
  vaciarCesta();
  cerrarCesta();
  renderGrid();
  renderTablaInventario();

  // Vibrar (feedback háptico)
  if (navigator.vibrate) navigator.vibrate([40, 20, 40]);

  mostrarModal({
    icono: '✅',
    titulo: '¡Venta completada!',
    mensaje: cajaMensaje,
    btnOk: 'Aceptar'
  });
}

/* ──────────────────────────────────────────────
   13. INVENTARIO — TABLA
────────────────────────────────────────────── */
function renderTablaInventario() {
  const productos = Store.getProductos();
  const tbody     = document.getElementById('tbody-inv');
  const subtitulo = document.getElementById('subtitulo-inv');

  subtitulo.textContent = `${productos.length} producto${productos.length !== 1 ? 's' : ''}`;
  tbody.innerHTML = '';

  if (productos.length === 0) {
    tbody.innerHTML = `<tr><td colspan="7" style="text-align:center;padding:32px;color:var(--text3)">
      No hay productos. Pulsa "Añadir" para empezar.
    </td></tr>`;
    return;
  }

  productos.forEach(p => {
    const vendidos    = calcVendidos(p.id);
    const stockActual = p.stockInicial - vendidos;
    const agotado     = stockActual <= 0;

    const tr = document.createElement('tr');
    if (agotado) tr.className = 'agotado-row';

    tr.innerHTML = `
      <td>
        <div class="thumb-inv">
          ${p.imagen ? `<img src="${p.imagen}" alt="">` : '🛍️'}
        </div>
      </td>
      <td style="font-weight:600;max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
        ${esc(p.nombre)}
      </td>
      <td class="num-amarillo">${fmtEuro(p.precio)}</td>
      <td class="num-gris">${p.stockInicial}</td>
      <td class="num-gris">${vendidos > 0 ? `<span class="num-verde">+${vendidos}</span>` : '—'}</td>
      <td class="${agotado ? 'num-rojo' : stockActual <= 3 ? 'num-amarillo' : 'num-verde'}"
          style="font-weight:700">${stockActual}</td>
      <td>
        <button class="btn-del-prod" data-id="${p.id}" aria-label="Eliminar ${esc(p.nombre)}">🗑</button>
      </td>
    `;
    tbody.appendChild(tr);
  });

  // Botones eliminar
  tbody.querySelectorAll('.btn-del-prod').forEach(btn => {
    btn.addEventListener('click', () => {
      const nombre = btn.getAttribute('aria-label').replace('Eliminar ', '');
      mostrarModal({
        icono: '🗑️',
        titulo: '¿Eliminar producto?',
        mensaje: `Se eliminará "<strong>${nombre}</strong>" del inventario. Esta acción no se puede deshacer.`,
        btnOk: 'Eliminar',
        btnCancel: 'Cancelar',
        onOk: () => {
          eliminarProducto(btn.dataset.id);
        }
      });
    });
  });
}

function eliminarProducto(id) {
  let productos = Store.getProductos();
  productos = productos.filter(p => p.id !== id);
  Store.setProductos(productos);
  renderTablaInventario();
  renderGrid();
  mostrarToast('Producto eliminado');
}

/* ──────────────────────────────────────────────
   14. FORMULARIO AÑADIR PRODUCTO
────────────────────────────────────────────── */
let imagenBase64 = null;

document.getElementById('btn-toggle-form').addEventListener('click', () => {
  const form = document.getElementById('form-producto');
  form.classList.toggle('open');
  if (form.classList.contains('open')) {
    document.getElementById('inp-nombre').focus();
    document.getElementById('btn-toggle-form').textContent = '✕ Cerrar';
  } else {
    resetForm();
    document.getElementById('btn-toggle-form').innerHTML = '<span>＋</span> Añadir';
  }
});

document.getElementById('btn-cancelar-form').addEventListener('click', () => {
  document.getElementById('form-producto').classList.remove('open');
  document.getElementById('btn-toggle-form').innerHTML = '<span>＋</span> Añadir';
  resetForm();
});

// Selección de imagen
document.getElementById('input-imagen').addEventListener('change', function() {
  const archivo = this.files[0];
  if (!archivo) return;

  document.getElementById('file-label-text').textContent = archivo.name;

  const reader = new FileReader();
  reader.onload = function(e) {
    imagenBase64 = e.target.result;
    const preview = document.getElementById('preview-imagen');
    preview.src   = imagenBase64;
    preview.style.display = 'block';
  };
  reader.readAsDataURL(archivo);
});

// Guardar producto
document.getElementById('btn-guardar-producto').addEventListener('click', () => {
  const nombre = document.getElementById('inp-nombre').value.trim();
  const precio = parseFloat(document.getElementById('inp-precio').value);
  const stock  = parseInt(document.getElementById('inp-stock').value);

  // Validaciones
  if (!nombre) {
    mostrarToast('⚠ El nombre no puede estar vacío'); return;
  }
  if (isNaN(precio) || precio <= 0) {
    mostrarToast('⚠ El precio debe ser mayor que cero'); return;
  }
  if (isNaN(stock) || stock < 0) {
    mostrarToast('⚠ El stock inicial debe ser ≥ 0'); return;
  }
  if (!imagenBase64) {
    mostrarToast('⚠ Selecciona una imagen para el producto'); return;
  }

  const nuevo = {
    id:           'p_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7),
    nombre,
    precio,
    stockInicial: stock,
    imagen:       imagenBase64
  };

  const productos = Store.getProductos();
  productos.push(nuevo);
  Store.setProductos(productos);

  resetForm();
  document.getElementById('form-producto').classList.remove('open');
  document.getElementById('btn-toggle-form').innerHTML = '<span>＋</span> Añadir';

  renderTablaInventario();
  renderGrid();
  mostrarToast('✓ Producto añadido correctamente');
});

function resetForm() {
  document.getElementById('inp-nombre').value  = '';
  document.getElementById('inp-precio').value  = '';
  document.getElementById('inp-stock').value   = '';
  document.getElementById('input-imagen').value = '';
  document.getElementById('file-label-text').textContent = 'Seleccionar foto o usar cámara';
  document.getElementById('preview-imagen').style.display = 'none';
  imagenBase64 = null;
}

/* ──────────────────────────────────────────────
   15. REINICIAR DATOS
────────────────────────────────────────────── */
document.getElementById('btn-reiniciar').addEventListener('click', () => {
  mostrarModal({
    icono: '⚠️',
    titulo: '¿Reiniciar todo?',
    mensaje: 'Se eliminarán <strong>todos</strong> los productos, ventas e imágenes. Esta acción es irreversible.',
    btnOk: 'Sí, reiniciar',
    btnCancel: 'Cancelar',
    onOk: () => {
      Store.reiniciar();
      vaciarCesta();
      renderTablaInventario();
      renderGrid();
      mostrarToast('Datos reiniciados');
    }
  });
});

/* ──────────────────────────────────────────────
   16. MODAL GENÉRICO
────────────────────────────────────────────── */
function mostrarModal({ icono, titulo, mensaje, btnOk, btnCancel, onOk, onCancel } = {}) {
  document.getElementById('modal-icon').textContent   = icono || '';
  document.getElementById('modal-title').textContent  = titulo || '';
  document.getElementById('modal-msg').innerHTML      = mensaje || '';
  document.getElementById('modal-cambio').style.display = 'none';

  const acciones = document.getElementById('modal-acciones');
  acciones.innerHTML = '';

  if (btnCancel) {
    const bc = document.createElement('button');
    bc.className   = 'btn-modal-cancel';
    bc.textContent = btnCancel;
    bc.onclick     = () => { cerrarModal(); if (onCancel) onCancel(); };
    acciones.appendChild(bc);
  }

  const bo = document.createElement('button');
  bo.className   = 'btn-modal-ok';
  bo.textContent = btnOk || 'Aceptar';
  bo.onclick     = () => { cerrarModal(); if (onOk) onOk(); };
  acciones.appendChild(bo);

  document.getElementById('overlay').classList.add('open');
}

function cerrarModal() {
  document.getElementById('overlay').classList.remove('open');
}

document.getElementById('overlay').addEventListener('click', e => {
  if (e.target === document.getElementById('overlay')) cerrarModal();
});

/* ──────────────────────────────────────────────
   17. TOAST
────────────────────────────────────────────── */
let toastTimer;
function mostrarToast(msg, duration = 2500) {
  const toast  = document.getElementById('toast');
  toast.textContent = msg;
  toast.classList.add('visible');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => toast.classList.remove('visible'), duration);
}

/* ──────────────────────────────────────────────
   18. BANNER DE INSTALACIÓN (PWA)
────────────────────────────────────────────── */
let deferredInstall = null;

window.addEventListener('beforeinstallprompt', e => {
  e.preventDefault();
  deferredInstall = e;
  document.getElementById('install-banner').classList.add('visible');
});

document.getElementById('btn-instalar').addEventListener('click', async () => {
  if (!deferredInstall) return;
  deferredInstall.prompt();
  const { outcome } = await deferredInstall.userChoice;
  deferredInstall = null;
  document.getElementById('install-banner').classList.remove('visible');
  if (outcome === 'accepted') mostrarToast('✓ App instalada correctamente');
});

document.getElementById('btn-cerrar-banner').addEventListener('click', () => {
  document.getElementById('install-banner').classList.remove('visible');
});

window.addEventListener('appinstalled', () => {
  document.getElementById('install-banner').classList.remove('visible');
  mostrarToast('✓ MiTienda instalada 🎉');
});

/* ──────────────────────────────────────────────
   19. OCULTAR FAB al navegar a inventario
────────────────────────────────────────────── */
document.querySelectorAll('.nav-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    if (btn.dataset.screen !== 'vender') {
      document.getElementById('fab-cesta').classList.remove('visible');
    } else {
      actualizarFAB();
    }
  });
});

/* ──────────────────────────────────────────────
   20. INIT — arrancar la app
────────────────────────────────────────────── */
(function init() {
  renderGrid();
  renderTablaInventario();
  actualizarBadge();
  console.log('✓ MiTienda POS iniciado');
})();
</script>
</body>
</html>
